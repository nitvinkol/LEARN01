# Normalize detected text to LF. Let Git detect mixed-format Unity files
# such as .asset, which may contain either YAML or binary data.
* text=auto eol=lf

# Use CRLF in the working tree for Windows batch scripts.
*.[bB][aA][tT] text=auto eol=crlf
*.[cC][mM][dD] text=auto eol=crlf

# Git LFS tracks every file matching these extensions, regardless of size.
# For an oversized file with another extension, track its specific path:
# git lfs track --filename "Assets/path/to/file"
*.[pP][sS][dD] filter=lfs diff=lfs merge=lfs -text -eol
